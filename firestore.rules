rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Super admin UID (matches Profile.tsx ADMIN_UID)
    function isAdmin() {
      return request.auth.uid == 'NboBOK41rVcAEcs6nhRmrALQ0KC2';
    }

    // Admin access to all users and their data
    match /users/{uid=**} {
      allow read: if isAdmin();
    }

    // User's own courses (private)
    match /users/{uid}/courses/{courseId} {
      allow read, write: if request.auth.uid == uid;
    }

    // User's own rounds (private)
    match /users/{uid}/rounds/{roundId} {
      allow read, write: if request.auth.uid == uid;
    }

    // User's favorite courses (private)
    match /users/{uid}/favorites/{courseId} {
      allow read, write: if request.auth.uid == uid;
    }

    // Public courses - anyone can read (public in index or private but shareable via URL)
    // only creator or admin can edit
    match /courses/{courseId} {
      allow read: if true;
      allow create: if request.auth != null && 
                       request.resource.data.creatorUid == request.auth.uid;
      allow update, delete: if request.auth != null && 
                               (resource.data.creatorUid == request.auth.uid || isAdmin());
    }

    // User profile
    match /users/{uid} {
      allow read, write: if request.auth.uid == uid;
    }
  }
}
