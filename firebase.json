{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": [
    {
      "target": "street-golf-app",
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ]
    },
    {
      "target": "auth-handler",
      "public": "public",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "**/*.png",
        "**/*.jpg",
        "**/*.gif",
        "manifest.json"
      ]
    }
  ]
}
